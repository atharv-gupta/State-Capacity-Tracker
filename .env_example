# Copy to .env and fill in real values. .env is gitignored.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Airtable Personal Access Token — https://airtable.com/create/tokens
# Required scopes:
#   data.records:read
#   data.records:write
#   schema.bases:read
#   schema.bases:write
# Required access: the base referenced by AIRTABLE_BASE_ID below.
AIRTABLE_TOKEN=pat...

# Airtable base ID (looks like "appXXXXXXXXXXXXXX").
# Find it in the URL of your base, or via https://airtable.com/api
AIRTABLE_BASE_ID=app...

# Congress.gov API key — free, from https://api.congress.gov
# Used by congress_api_sync.py for hearings and bills. Without it that script
# skips cleanly and the rest of the congress pipeline still runs.
# Rate limit is 20,000 requests/hour, far above what the pipeline needs.
CONGRESS_API_KEY=...
