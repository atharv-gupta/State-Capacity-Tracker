# Copy to .env and fill in real values. .env is gitignored.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Airtable Personal Access Token — https://airtable.com/create/tokens
# Required scopes:
#   data.records:read
#   data.records:write
#   schema.bases:read
#   schema.bases:write
# Required access: the base referenced by AIRTABLE_BASE_ID below.
AIRTABLE_TOKEN=pat...

# Airtable base ID (looks like "appXXXXXXXXXXXXXX").
# Find it in the URL of your base, or via https://airtable.com/api
AIRTABLE_BASE_ID=app...

# Congress.gov API key — free, from https://api.congress.gov
# Used by congress_api_sync.py for hearings and bills. Without it that script
# skips cleanly and the rest of the congress pipeline still runs.
# Rate limit is 20,000 requests/hour, far above what the pipeline needs.
CONGRESS_API_KEY=...

# Resend API key — https://resend.com/api-keys
# Used by digest.py to send the weekly capacity digest. Without it, digest.py
# fails at send time (--dry-run and --html-out still work).
RESEND_API_KEY=re_...

# From-address for the digest. Must be a verified sender on the Resend account
# above. Defaults to onboarding@resend.dev (Resend's shared sandbox sender,
# which can only deliver to the account address) if unset — so a real
# distribution run needs this set explicitly.
DIGEST_FROM=digest@recodingamerica.org

# Public URL of the deployed web tracker, linked in the digest footer.
# Optional; defaults to the current Vercel deployment URL.
TRACKER_URL=https://state-tracker-e2i7.vercel.app/
